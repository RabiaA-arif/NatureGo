rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'rabiaarifai55@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid));
      
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        incoming().userId == request.auth.uid &&
        incoming().email is string &&
        incoming().role in ['user', 'admin'];

      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().userId == existing().userId) ||
        isAdmin()
      );

      allow delete: if isAdmin();

      // Explorer journal discoveries subcollection
      match /discoveries/{discoveryId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(discoveryId) &&
          incoming().userId == request.auth.uid;

        allow update: if isSignedIn() &&
          request.auth.uid == userId &&
          incoming().userId == existing().userId;

        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Admin designation records
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection doc for initial boot validation
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
